# Copy this file to .env.local (for QA) and .env.production.local (for Production)
# and fill in the real values. Never commit the filled-in files — .env* is gitignored.

# Supabase project URL and Publishable Key (Supabase's current name for what
# used to be called the "anon/public key" — same purpose, safe to expose in
# browser code) — same project for both environments, since we're using one
# Supabase project with separate `prod` and `qa` schemas (see REQUIREMENTS.md
# §1.1). Find these in Supabase Dashboard > Project Settings > API Keys.
# Never use the "Secret Key" (formerly "service_role") here — that one must
# never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which schema this deployment should talk to: "qa" or "prod".
# Used to set the Postgres search_path / PostgREST schema for all queries.
NEXT_PUBLIC_APP_ENV=qa
