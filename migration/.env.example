# Copy this file to .env and fill in real values. Never commit .env itself
# (already in .gitignore) -- it holds real credentials.

# Which schema this run targets. The tool refuses to run against "prod"
# unless MIGRATE_CONFIRM_PROD is also set to exactly "yes" -- see README.
MIGRATE_SCHEMA=qa

# Supabase project URL + SERVICE ROLE key (not the anon key -- this needs to
# bypass RLS and use the Auth admin API to pre-provision accounts). Find both
# in the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Path to the Google service account's JSON key file (see README for how to
# create one and share the source spreadsheets with it). Relative paths are
# resolved from this migration/ directory.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Only needed to run against prod: must be exactly "yes", nothing else works.
# MIGRATE_CONFIRM_PROD=yes
